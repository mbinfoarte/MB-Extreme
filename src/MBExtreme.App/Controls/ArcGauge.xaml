<UserControl x:Class="MBExtreme.UI.Controls.ArcGauge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Viewbox Stretch="Uniform">
        <Grid Width="160" Height="160">
            <Canvas Width="160" Height="160">
                <Path x:Name="Track" Stroke="{StaticResource Surface2Brush}" StrokeThickness="12"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Path x:Name="Arc" StrokeThickness="12" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Canvas>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,6,0,0">
                <TextBlock x:Name="ValueText" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock x:Name="UnitText" FontSize="12" HorizontalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
        </Grid>
    </Viewbox>
</UserControl>

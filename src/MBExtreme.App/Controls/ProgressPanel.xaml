<UserControl x:Class="MBExtreme.UI.Controls.ProgressPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:MBExtreme.UI.Controls">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Card}" Margin="0,0,16,0">
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,16" />
                <StackPanel x:Name="StepsList" />
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="24">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ctl:ProgressRing x:Name="Ring" HorizontalAlignment="Center" />
                <TextBlock x:Name="StatusText" Margin="0,24,0,0" FontSize="16" TextAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="520" />
                <TextBlock x:Name="DetailText" Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap"
                           MaxWidth="520" Foreground="{StaticResource MutedBrush}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                    <Button x:Name="StopButton" Content="Parar" Style="{StaticResource GhostButton}"
                            Click="StopButton_Click" />
                    <Button x:Name="CloseButton" Content="Fechar" Style="{StaticResource PrimaryButton}"
                            Click="CloseButton_Click" Visibility="Collapsed" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

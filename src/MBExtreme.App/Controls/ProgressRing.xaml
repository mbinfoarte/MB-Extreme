<UserControl x:Class="MBExtreme.UI.Controls.ProgressRing"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="240" Height="240">
    <Grid>
        <Ellipse Width="200" Height="200" StrokeThickness="12" Stroke="{StaticResource Surface2Brush}" />
        <Canvas Width="240" Height="240">
            <Path x:Name="Arc" Stroke="{StaticResource AccentBrush}" StrokeThickness="12"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                <Path.Effect>
                    <DropShadowEffect Color="#FFCC00" BlurRadius="18" ShadowDepth="0" Opacity="0.6" />
                </Path.Effect>
            </Path>
        </Canvas>
        <TextBlock x:Name="Label" Text="0%" FontSize="44" FontWeight="SemiBold"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
</UserControl>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>MBExtreme.UI</RootNamespace>
    <AssemblyName>MBExtreme</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.9.0</Version>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Embute as DLLs nativas do WPF no executável único (sem isso, o .exe sozinho não abre). -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <!-- índice de CPUs e placas (gerado a partir do Blender Open Data na compilação); sem o arquivo, o app só não mostra a posição -->
  <ItemGroup Condition="Exists('Assets\hardware-index.json')">
    <None Include="Assets\hardware-index.json" Link="hardware-index.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="Vosk" Version="0.3.38" />
    <PackageReference Include="Nefarius.ViGEm.Client" Version="1.21.256" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MBExtreme.Core\MBExtreme.Core.csproj" />
  </ItemGroup>

</Project>

<Window x:Class="MBExtreme.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MB Extreme (Beta 01)" Width="1240" Height="740" MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/app.ico" WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="True"
        Background="Transparent" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- Botões de minimizar, maximizar e fechar dentro do próprio layout -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="0,0,0,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#26FFFFFF" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseBg" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseBg" Property="Background" Value="#E81123" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border x:Name="WindowFrame" CornerRadius="22" Background="{StaticResource WindowBackdropBrush}"
            BorderBrush="{StaticResource SidebarEdgeBrush}" BorderThickness="1">
    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="214" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Reflexo do vidro por cima do fundo (efeito cristal) -->
        <Border x:Name="GlassSheen" Grid.ColumnSpan="2" CornerRadius="21" Background="{StaticResource GlassSheenBrush}" IsHitTestVisible="False" />

        <!-- Menu lateral: marca no alto, itens em seções e, embaixo, conta, tamanho da letra e versão -->
        <Border Margin="8,8,4,8" CornerRadius="18" Background="{StaticResource SidebarGlassBrush}" BorderBrush="{StaticResource SidebarEdgeBrush}" BorderThickness="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="14,14,12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" CornerRadius="17" BorderBrush="#FFC400" BorderThickness="1.5">
                            <Border.Background>
                                <ImageBrush ImageSource="Assets/logo.png" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                            <TextBlock FontSize="15" FontWeight="Black">
                                <Run Text="MB " /><Run Text="EXTREME" Foreground="#FFC400" />
                            </TextBlock>
                            <TextBlock x:Name="FooterText" Text="by MB InfoArt" FontSize="9.5" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                    <Border x:Name="FreeBadge" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="7,1,8,2" CornerRadius="8"
                            Background="#1FFFC400" ToolTip="Você está no plano grátis. Os recursos Pro liberam quando você assina."
                            AutomationProperties.Name="Licença: Grátis">
                        <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#FFC400"><Run FontFamily="Segoe MDL2 Assets" Text="&#xE73E;" /><Run x:Name="BadgeText" Text=" Licença: Grátis" /></TextBlock>
                    </Border>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="10,6,10,12">
                    <Border x:Name="ProfileCard" Padding="8,6" CornerRadius="10" Cursor="Hand" Background="{StaticResource SurfaceBrush}"
                            MouseLeftButtonUp="Profile_Click" ToolTip="Licença e conta">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="AvatarBorder" Width="28" Height="28" CornerRadius="14" Background="{StaticResource AccentBrush}">
                                <TextBlock x:Name="AvatarInitials" Text="MB" Foreground="#111" FontWeight="Bold" FontSize="11"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="CustomerName" Text="Visitante" FontWeight="SemiBold" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="CustomerPlan" Text="Plano gratuito" FontSize="10" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Button x:Name="ActivateButton" Content="Ativar o Pro" Style="{StaticResource PrimaryButton}" Margin="0,6,0,0"
                            Padding="10,4" FontSize="11.5" Click="Activate_Click" />
                    <Button Style="{StaticResource SideFooterButton}" Margin="0,6,0,0" Click="FontSize_Click" ToolTip="Interface maior ou menor (Ctrl + e Ctrl −)">
                        <TextBlock><Run FontFamily="Segoe MDL2 Assets" Text="&#xE8D2;" /><Run Text="  Tamanho da letra" /></TextBlock>
                    </Button>
                    <Button x:Name="VersionButton" Style="{StaticResource SideFooterButton}" Margin="0,2,0,0" Click="CheckUpdate_Click">
                        <TextBlock x:Name="VersionText" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                    </Button>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="NavPanel" Margin="8,0,8,0" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <ContentControl x:Name="ContentHost" Grid.Column="1" Margin="0,30,6,0" />

        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="10">
            <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="Minimizar" Click="Minimize_Click" />
            <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" ToolTip="Maximizar" Click="Maximize_Click" />
            <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" ToolTip="Fechar" Click="Close_Click" />
        </StackPanel>
    </Grid>
    </Border>
</Window>

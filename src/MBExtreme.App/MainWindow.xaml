<Window x:Class="MBExtreme.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MB Extreme (Beta 01)" Width="1240" Height="740" MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/app.ico" WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="True"
        Background="Transparent" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- Botões de minimizar, maximizar e fechar dentro do próprio layout -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="0,0,0,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#26FFFFFF" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseBg" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseBg" Property="Background" Value="#E81123" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border x:Name="WindowFrame" CornerRadius="22" Background="{StaticResource WindowBackdropBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Margin="12" CornerRadius="20" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <DockPanel>
                <!-- Cliente: foto, nome, plano e dias restantes -->
                <Border x:Name="ProfileCard" DockPanel.Dock="Top" Margin="10,12,10,6" Padding="12,10" CornerRadius="16" Cursor="Hand"
                        Background="{StaticResource Surface2Brush}" MouseLeftButtonUp="Profile_Click" ToolTip="Licença e conta">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="AvatarBorder" Width="42" Height="42" CornerRadius="21" Background="{StaticResource AccentBrush}">
                                <TextBlock x:Name="AvatarInitials" Text="MB" Foreground="#111" FontWeight="Bold" FontSize="15"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="CustomerName" Text="Visitante" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="CustomerPlan" Text="Plano gratuito" FontSize="11" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                        <Button x:Name="ActivateButton" Content="Ativar o Pro" Style="{StaticResource PrimaryButton}" Margin="0,10,0,0"
                                Padding="10,5" FontSize="12" Click="Activate_Click" />
                    </StackPanel>
                </Border>

                <!-- Sistema: logo arredondado, nome e versão -->
                <Grid DockPanel.Dock="Bottom" Margin="18,8,12,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" CornerRadius="10">
                        <Border.Background>
                            <ImageBrush ImageSource="Assets/logo.png" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="14" FontWeight="Bold" Text="MB EXTREME" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="FooterText" Text="Beta 01 · by MB InfoArt" FontSize="10" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="NavPanel" Margin="10,2,10,0">
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <ContentControl x:Name="ContentHost" Grid.Column="1" Margin="0,30,6,0" />

        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="10">
            <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="Minimizar" Click="Minimize_Click" />
            <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" ToolTip="Maximizar" Click="Maximize_Click" />
            <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" ToolTip="Fechar" Click="Close_Click" />
        </StackPanel>
    </Grid>
    </Border>
</Window>

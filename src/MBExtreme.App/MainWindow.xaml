<Window x:Class="MBExtreme.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MB Extreme" Width="1280" Height="780" MinWidth="1040" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/app.ico"
        Background="{StaticResource WindowBackdropBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Margin="14" CornerRadius="24" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="22,26,22,22">
                    <Border Width="64" Height="64" CornerRadius="32" ClipToBounds="True" HorizontalAlignment="Left">
                        <Image Source="Assets/logo.png" Stretch="UniformToFill" />
                    </Border>
                    <TextBlock FontSize="22" FontWeight="Bold" Margin="0,12,0,0" Text="MB EXTREME" />
                    <TextBlock Text="by MB InfoArt" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom" Text="v0.3 · pré-lançamento" FontSize="11" Margin="24,14"
                           Foreground="{StaticResource MutedBrush}" />

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="NavPanel" Margin="12,0,12,0">
                        <RadioButton Tag="home" IsChecked="True" GroupName="nav" Style="{StaticResource NavItem}" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="18" Text="&#xE80F;" Width="28" VerticalAlignment="Center" />
                                <TextBlock Text="Painel" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Tag="opt" GroupName="nav" Style="{StaticResource NavItem}" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="18" Text="&#xE945;" Width="28" VerticalAlignment="Center" />
                                <TextBlock Text="Otimização" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Tag="net" GroupName="nav" Style="{StaticResource NavItem}" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="18" Text="&#xE774;" Width="28" VerticalAlignment="Center" />
                                <TextBlock Text="Rede" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Tag="win" GroupName="nav" Style="{StaticResource NavItem}" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="18" Text="&#xE713;" Width="28" VerticalAlignment="Center" />
                                <TextBlock Text="Windows" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Tag="tools" GroupName="nav" Style="{StaticResource NavItem}" Checked="Nav_Checked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="18" Text="&#xE90F;" Width="28" VerticalAlignment="Center" />
                                <TextBlock Text="Ferramentas" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <ContentControl x:Name="ContentHost" Grid.Column="1" Margin="0,0,6,0" />
    </Grid>
</Window>

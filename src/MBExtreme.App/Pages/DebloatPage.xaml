<UserControl x:Class="MBExtreme.UI.Pages.DebloatPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:MBExtreme.UI.Controls">
    <Grid>
        <ScrollViewer x:Name="MainView" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40,32">
                <TextBlock Text="Aplicativos do Windows" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Margin="0,4,0,18" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                           Text="Remova aplicativos que acompanham o Windows e que você não usa. Escolha um por um. Um ponto de restauração é criado antes." />

                <StackPanel Orientation="Horizontal">
                    <Button Content="Remover selecionados" Style="{StaticResource PrimaryButton}" Click="RemoveButton_Click" />
                    <Button Content="Selecionar os seguros" Style="{StaticResource GhostButton}" Margin="12,0,0,0"
                            Click="SelectSafeButton_Click" />
                    <Button Content="Limpar seleção" Style="{StaticResource GhostButton}" Margin="12,0,0,0"
                            Click="ClearButton_Click" />
                </StackPanel>
                <TextBlock x:Name="StatusText" Margin="0,12,0,0" TextWrapping="Wrap" />

                <StackPanel x:Name="RowsHost" Margin="0,18,0,0" />

                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                           Text="A remoção vale para o seu usuário. Para reinstalar um aplicativo, use a Microsoft Store ou o winget (menu Drivers e programas > Programas). Remover a Loja ou o Xbox é difícil de reverter." />
            </StackPanel>
        </ScrollViewer>

        <ctl:ProgressPanel x:Name="ProgressView" Visibility="Collapsed" Background="{StaticResource OverlayBrush}" />
    </Grid>
</UserControl>

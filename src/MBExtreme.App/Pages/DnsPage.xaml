<UserControl x:Class="MBExtreme.UI.Pages.DnsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:MBExtreme.UI.Controls">
    <Grid>
        <ScrollViewer x:Name="MainView" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40,32">
                <TextBlock Text="DNS" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="Teste vários servidores DNS e escolha o mais rápido para a sua conexão."
                           Margin="0,4,0,20" Foreground="{StaticResource MutedBrush}" />

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="DNS atual" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock x:Name="CurrentText" FontSize="16" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock x:Name="LastTestText" Margin="0,10,0,0" Foreground="{StaticResource MutedBrush}"
                                   Text="Nenhum teste executado ainda." />
                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button Content="Testar servidores" Style="{StaticResource PrimaryButton}" Click="TestButton_Click" />
                            <Button Content="Restaurar padrão do Windows" Style="{StaticResource GhostButton}"
                                    Margin="12,0,0,0" Click="RestoreButton_Click" />
                        </StackPanel>
                        <TextBlock x:Name="StatusText" Margin="0,14,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border x:Name="ResultsCard" Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Resultado do teste" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <StackPanel x:Name="ResultsList" />
                    </StackPanel>
                </Border>

                <TextBlock Margin="0,16,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                           Text="O DNS acelera a abertura de sites e a conexão com servidores. Ele não muda a rota nem o ping dentro de uma partida online. Alguns provedores filtram anúncios ou conteúdo (veja a nota de cada um)." />
            </StackPanel>
        </ScrollViewer>

        <ctl:ProgressPanel x:Name="ProgressView" Visibility="Collapsed" Background="{StaticResource OverlayBrush}" />
    </Grid>
</UserControl>

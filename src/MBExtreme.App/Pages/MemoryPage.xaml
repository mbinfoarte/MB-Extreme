<UserControl x:Class="MBExtreme.UI.Pages.MemoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:MBExtreme.UI.Controls">
    <Grid>
        <ScrollViewer x:Name="MainView" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40,32">
                <TextBlock Text="Memória" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="Libere RAM antes de jogar, sem fechar o que você precisa."
                           Margin="0,4,0,20" Foreground="{StaticResource MutedBrush}" />

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="LevelDot" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock x:Name="LevelText" FontSize="20" FontWeight="SemiBold" />
                        </StackPanel>
                        <UniformGrid Columns="3" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="Usada" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock x:Name="UsedText" FontSize="22" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Livre" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock x:Name="FreeText" FontSize="22" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Total" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock x:Name="TotalText" FontSize="22" />
                            </StackPanel>
                        </UniformGrid>
                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                            <Button Content="Limpar agora" Style="{StaticResource PrimaryButton}" Click="CleanButton_Click" />
                            <Button Content="Atualizar" Style="{StaticResource GhostButton}" Margin="12,0,0,0" Click="RefreshButton_Click" />
                        </StackPanel>
                        <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                                   Text="Esvaziar o cache da memória só ajuda quando a RAM está quase cheia. Fazer isso sem necessidade pode deixar o início dos programas mais lento." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Aplicativos protegidos" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Margin="0,4,0,12" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                                   Text="Estes processos não são tocados na limpeza. Digite o nome do processo, como aparece no Gerenciador de Tarefas, sem .exe (ex.: obs64)." />
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="AllowBox" Width="260" KeyDown="AllowBox_KeyDown" />
                            <Button Content="Adicionar" Style="{StaticResource GhostButton}" Margin="12,0,0,0" Click="AddAllowButton_Click" />
                        </StackPanel>
                        <StackPanel x:Name="AllowList" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <TextBlock Margin="0,16,0,0" Foreground="{StaticResource MutedBrush}"
                           Text="Dica: o Modo Jogo (menu Jogos) limpa e ajusta o PC automaticamente quando um jogo abre." />
            </StackPanel>
        </ScrollViewer>

        <ctl:ProgressPanel x:Name="ProgressView" Visibility="Collapsed" Background="{StaticResource OverlayBrush}" />
    </Grid>
</UserControl>

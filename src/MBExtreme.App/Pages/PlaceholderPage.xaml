<UserControl x:Class="MBExtreme.UI.Pages.PlaceholderPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="40" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">
        <TextBlock x:Name="TitleText" FontSize="28" FontWeight="SemiBold" TextAlignment="Center" />
        <TextBlock x:Name="DescriptionText" Margin="0,12,0,0" TextAlignment="Center" TextWrapping="Wrap"
                   Foreground="{StaticResource MutedBrush}" />
        <Border Margin="0,24,0,0" HorizontalAlignment="Center" Padding="14,6" CornerRadius="14"
                Background="{StaticResource Surface2Brush}">
            <TextBlock Text="Indisponível nesta versão" Foreground="{StaticResource AccentBrush}" FontSize="12" />
        </Border>
    </StackPanel>
</UserControl>

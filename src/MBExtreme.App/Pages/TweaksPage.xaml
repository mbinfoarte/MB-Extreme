<UserControl x:Class="MBExtreme.UI.Pages.TweaksPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:MBExtreme.UI.Controls">
    <Grid>
        <ScrollViewer x:Name="MainView" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40,32">
                <TextBlock x:Name="TitleText" FontSize="28" FontWeight="SemiBold" />
                <TextBlock x:Name="SubtitleText" Margin="0,4,0,18" TextWrapping="Wrap"
                           Foreground="{StaticResource MutedBrush}" />

                <!-- níveis no mesmo visual das abas de cima: Básico, Avançado e Extreme marcam os ajustes; Aplicar confirma -->
                <WrapPanel x:Name="LevelHost" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Button Content="Aplicar" Style="{StaticResource PrimaryButton}" Click="ApplyButton_Click" Padding="22,7" />
                    <Button Content="Desmarcar tudo" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="RecommendedButton_Click" Tag="None" />
                    <Button Content="Restaurar originais" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="RestoreButton_Click" />
                    <Button Content="Fazer com um especialista" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="SpecialistButton_Click"
                            ToolTip="Um técnico da MB InfoArt otimiza o seu PC pelo acesso remoto (incluso nos planos anuais)" />
                </StackPanel>
                <TextBlock x:Name="StatusText" Margin="0,12,0,0" TextWrapping="Wrap" />

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <WrapPanel x:Name="FilterHost" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="CounterText" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}" />
                        <TextBox x:Name="SearchBox" Width="220" ToolTip="Procurar otimização pelo nome ou pelo que ela faz"
                                 TextChanged="SearchBox_TextChanged" />
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="RowsHost" Margin="0,18,0,0" />

                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                           Text="Marque os ajustes que quer e clique em Aplicar alterações. Antes de mudar qualquer coisa, o app guarda o valor original; Restaurar originais desfaz tudo o que foi aplicado por aqui." />
            </StackPanel>
        </ScrollViewer>

        <ctl:ProgressPanel x:Name="ProgressView" Visibility="Collapsed" Background="{StaticResource OverlayBrush}" />
    </Grid>
</UserControl>

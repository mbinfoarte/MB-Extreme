<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Fundo preto. O amarelo da marca fica só nos botões. -->
    <Color x:Key="BgColor">#070707</Color>
    <Color x:Key="SurfaceColor">#121214</Color>
    <Color x:Key="Surface2Color">#1B1B1F</Color>
    <Color x:Key="BorderColor">#26262B</Color>
    <Color x:Key="AccentColor">#F4F4F5</Color>
    <Color x:Key="AccentHoverColor">#FFFFFF</Color>
    <Color x:Key="TextColor">#F4F4F5</Color>
    <Color x:Key="MutedColor">#8E8E96</Color>
    <Color x:Key="OkColor">#3DDC97</Color>
    <Color x:Key="WarnColor">#FFA94D</Color>
    <Color x:Key="BadColor">#FF5A5F</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#F2070707" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2Color}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="OkBrush" Color="{StaticResource OkColor}" />
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}" />
    <SolidColorBrush x:Key="BadBrush" Color="{StaticResource BadColor}" />

    <!-- Tempo dos efeitos de passar o mouse e clicar (o programa zera quando as animações estão desligadas) -->
    <Duration x:Key="MotionHover">0:0:0.14</Duration>

    <!-- Fundo da janela: degradê de cinza-escuro para quase preto (não é 100% preto) -->
    <LinearGradientBrush x:Key="WindowSolidBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#202227" Offset="0" />
        <GradientStop Color="#131418" Offset="0.45" />
        <GradientStop Color="#08080A" Offset="1" />
    </LinearGradientBrush>
    <!-- O mesmo degradê um pouco transparente, para o efeito cristal (o Windows desfoca o que está atrás) -->
    <LinearGradientBrush x:Key="WindowGlassBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#D9262930" Offset="0" />
        <GradientStop Color="#E6141519" Offset="0.45" />
        <GradientStop Color="#F008080A" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="WindowBackdropBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#202227" Offset="0" />
        <GradientStop Color="#131418" Offset="0.45" />
        <GradientStop Color="#08080A" Offset="1" />
    </LinearGradientBrush>
    <!-- Reflexo do vidro: faixas claras na diagonal, bem de leve, como no Aero -->
    <LinearGradientBrush x:Key="GlassSheenBrush" StartPoint="0,0" EndPoint="1,0.55">
        <GradientStop Color="#16FFFFFF" Offset="0" />
        <GradientStop Color="#08FFFFFF" Offset="0.27" />
        <GradientStop Color="#00FFFFFF" Offset="0.30" />
        <GradientStop Color="#00FFFFFF" Offset="0.60" />
        <GradientStop Color="#07FFFFFF" Offset="0.62" />
        <GradientStop Color="#00FFFFFF" Offset="0.80" />
    </LinearGradientBrush>
    <!-- Menu lateral de vidro escuro -->
    <LinearGradientBrush x:Key="SidebarGlassBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#C81A1B20" Offset="0" />
        <GradientStop Color="#D20F1013" Offset="0.5" />
        <GradientStop Color="#DC0A0A0C" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SidebarEdgeBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#38FFFFFF" Offset="0" />
        <GradientStop Color="#14FFFFFF" Offset="0.4" />
        <GradientStop Color="#10FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <!-- Item escolhido do menu: vidro amarelado que some para a direita -->
    <LinearGradientBrush x:Key="SideSelectedBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#38FFC400" Offset="0" />
        <GradientStop Color="#14FFC400" Offset="0.55" />
        <GradientStop Color="#06FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SideSelectedEdgeBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#66FFC400" Offset="0" />
        <GradientStop Color="#22FFFFFF" Offset="0.6" />
        <GradientStop Color="#0AFFFFFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SideSheenBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1CFFFFFF" Offset="0" />
        <GradientStop Color="#08FFFFFF" Offset="0.48" />
        <GradientStop Color="#00FFFFFF" Offset="0.5" />
    </LinearGradientBrush>

    <!-- Degradê da marca: amarelo para laranja (barra do menu, abas e cartões escolhidos) -->
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFD84D" Offset="0" />
        <GradientStop Color="#FFC400" Offset="0.45" />
        <GradientStop Color="#FF8A00" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentGradientVertical" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFE066" Offset="0" />
        <GradientStop Color="#FFC400" Offset="0.5" />
        <GradientStop Color="#FF7A00" Offset="1" />
    </LinearGradientBrush>
    <!-- Vidro: branco quase transparente em cima, sumindo para baixo, com um toque amarelo -->
    <LinearGradientBrush x:Key="GlassSelectedBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2EFFE27A" Offset="0" />
        <GradientStop Color="#14FFC400" Offset="0.5" />
        <GradientStop Color="#0AFFFFFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassEdgeBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#55FFFFFF" Offset="0" />
        <GradientStop Color="#18FFFFFF" Offset="0.5" />
        <GradientStop Color="#40FFC400" Offset="1" />
    </LinearGradientBrush>

    <!-- Botões: amarelo da marca com leve degradê -->
    <LinearGradientBrush x:Key="ButtonBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFDD33" Offset="0" />
        <GradientStop Color="#FFC400" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ButtonHoverBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFE766" Offset="0" />
        <GradientStop Color="#FFD21A" Offset="1" />
    </LinearGradientBrush>

    <!-- Arcos e gráficos: branco para cinza -->
    <LinearGradientBrush x:Key="GaugeBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#9AA0A6" Offset="1" />
    </LinearGradientBrush>

    <!-- Cartão arredondado -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <!-- Botão principal: amarelo, texto preto -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="#0B0B0B" />
        <Setter Property="Background" Value="{StaticResource ButtonBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="24,11" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="14"
                            Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform><ScaleTransform x:Name="Motion" /></Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Motion" Storyboard.TargetProperty="ScaleX" To="1.03" Duration="{StaticResource MotionHover}" /><DoubleAnimation Storyboard.TargetName="Motion" Storyboard.TargetProperty="ScaleY" To="1.03" Duration="{StaticResource MotionHover}" /></Storyboard></BeginStoryboard></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Motion" Storyboard.TargetProperty="ScaleX" To="1" Duration="{StaticResource MotionHover}" /><DoubleAnimation Storyboard.TargetName="Motion" Storyboard.TargetProperty="ScaleY" To="1" Duration="{StaticResource MotionHover}" /></Storyboard></BeginStoryboard></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Motion" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="{StaticResource MotionHover}" /><DoubleAnimation Storyboard.TargetName="Motion" Storyboard.TargetProperty="ScaleY" To="0.96" Duration="{StaticResource MotionHover}" /></Storyboard></BeginStoryboard></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Motion" Storyboard.TargetProperty="ScaleX" To="1.03" Duration="{StaticResource MotionHover}" /><DoubleAnimation Storyboard.TargetName="Motion" Storyboard.TargetProperty="ScaleY" To="1.03" Duration="{StaticResource MotionHover}" /></Storyboard></BeginStoryboard></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource ButtonHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botão secundário: escuro, texto claro -->
    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="20,10" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="14"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform><ScaleTransform x:Name="Motion" /></Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Motion" Storyboard.TargetProperty="ScaleX" To="1.03" Duration="{StaticResource MotionHover}" /><DoubleAnimation Storyboard.TargetName="Motion" Storyboard.TargetProperty="ScaleY" To="1.03" Duration="{StaticResource MotionHover}" /></Storyboard></BeginStoryboard></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Motion" Storyboard.TargetProperty="ScaleX" To="1" Duration="{StaticResource MotionHover}" /><DoubleAnimation Storyboard.TargetName="Motion" Storyboard.TargetProperty="ScaleY" To="1" Duration="{StaticResource MotionHover}" /></Storyboard></BeginStoryboard></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Motion" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="{StaticResource MotionHover}" /><DoubleAnimation Storyboard.TargetName="Motion" Storyboard.TargetProperty="ScaleY" To="0.96" Duration="{StaticResource MotionHover}" /></Storyboard></BeginStoryboard></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Motion" Storyboard.TargetProperty="ScaleX" To="1.03" Duration="{StaticResource MotionHover}" /><DoubleAnimation Storyboard.TargetName="Motion" Storyboard.TargetProperty="ScaleY" To="1.03" Duration="{StaticResource MotionHover}" /></Storyboard></BeginStoryboard></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource MutedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botão grande de varredura: círculo amarelo, texto preto -->
    <Style x:Key="ScanButton" TargetType="Button">
        <Setter Property="Width" Value="180" />
        <Setter Property="Height" Value="180" />
        <Setter Property="Foreground" Value="#0B0B0B" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse x:Name="Ring" Fill="{StaticResource ButtonBrush}">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#FFC400" BlurRadius="30" ShadowDepth="0" Opacity="0.35" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Fill" Value="{StaticResource ButtonHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Ring" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Item do menu lateral (ícone + texto) -->
    <Style x:Key="NavItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="12" Margin="0,1.5"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface2Brush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface2Brush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Item do menu lateral em seções: compacto, barra amarela à esquerda quando selecionado -->
    <Style x:Key="SideItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="#B4B4BC" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="10,5.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Margin="0,0.5">
                        <!-- brilho que segue o mouse (o centro é movido pelo código: MouseGlow) -->
                        <Border x:Name="Glow" CornerRadius="8" Opacity="0" IsHitTestVisible="False" />
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" BorderThickness="1" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="Sheen" CornerRadius="8" Margin="1" Background="{StaticResource SideSheenBrush}" IsHitTestVisible="False" Visibility="Hidden" />
                        <Border x:Name="Bar" Width="3.5" CornerRadius="2" Margin="0,5" HorizontalAlignment="Left" Background="{StaticResource AccentGradientVertical}" Visibility="Hidden">
                            <Border.Effect>
                                <DropShadowEffect Color="#FFC400" BlurRadius="10" ShadowDepth="0" Opacity="0.85" />
                            </Border.Effect>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource MotionHover}" /></Storyboard></BeginStoryboard></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource MotionHover}" /></Storyboard></BeginStoryboard></Trigger.ExitActions>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#14FFFFFF" />
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SideSelectedBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource SideSelectedEdgeBrush}" />
                            <Setter TargetName="Sheen" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#FFC400" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Título de seção do menu lateral (clicável: recolhe e abre a seção) -->
    <Style x:Key="SideHeaderButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="10,4,10,4">
                        <ContentPresenter HorizontalAlignment="Stretch" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#0FFFFFFF" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#FFC400" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botões discretos do rodapé do menu lateral -->
    <Style x:Key="SideFooterButton" TargetType="Button">
        <Setter Property="Foreground" Value="#B4B4BC" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="8,4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF" />
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Cartão compacto de ferramenta (Painel e Todas as ferramentas) -->
    <Style x:Key="ToolTileButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{StaticResource SurfaceBrush}" CornerRadius="12"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="14,12" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform><ScaleTransform x:Name="Motion" /></Border.RenderTransform>
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Motion" Storyboard.TargetProperty="ScaleX" To="1.025" Duration="{StaticResource MotionHover}" /><DoubleAnimation Storyboard.TargetName="Motion" Storyboard.TargetProperty="ScaleY" To="1.025" Duration="{StaticResource MotionHover}" /></Storyboard></BeginStoryboard></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Motion" Storyboard.TargetProperty="ScaleX" To="1" Duration="{StaticResource MotionHover}" /><DoubleAnimation Storyboard.TargetName="Motion" Storyboard.TargetProperty="ScaleY" To="1" Duration="{StaticResource MotionHover}" /></Storyboard></BeginStoryboard></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Motion" Storyboard.TargetProperty="ScaleX" To="0.97" Duration="{StaticResource MotionHover}" /><DoubleAnimation Storyboard.TargetName="Motion" Storyboard.TargetProperty="ScaleY" To="0.97" Duration="{StaticResource MotionHover}" /></Storyboard></BeginStoryboard></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Motion" Storyboard.TargetProperty="ScaleX" To="1.025" Duration="{StaticResource MotionHover}" /><DoubleAnimation Storyboard.TargetName="Motion" Storyboard.TargetProperty="ScaleY" To="1.025" Duration="{StaticResource MotionHover}" /></Storyboard></BeginStoryboard></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface2Brush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#66FFC400" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#FFC400" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ícone das ferramentas: quadrado amarelo com o desenho em preto -->
    <Style x:Key="ToolIconBox" TargetType="Border">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{StaticResource ButtonBrush}" />
    </Style>

    <!-- Cartão clicável (atalhos dos módulos) -->
    <Style x:Key="TileButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{StaticResource SurfaceBrush}" CornerRadius="18"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="20" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform><ScaleTransform x:Name="Motion" /></Border.RenderTransform>
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Motion" Storyboard.TargetProperty="ScaleX" To="1.02" Duration="{StaticResource MotionHover}" /><DoubleAnimation Storyboard.TargetName="Motion" Storyboard.TargetProperty="ScaleY" To="1.02" Duration="{StaticResource MotionHover}" /></Storyboard></BeginStoryboard></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Motion" Storyboard.TargetProperty="ScaleX" To="1" Duration="{StaticResource MotionHover}" /><DoubleAnimation Storyboard.TargetName="Motion" Storyboard.TargetProperty="ScaleY" To="1" Duration="{StaticResource MotionHover}" /></Storyboard></BeginStoryboard></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Motion" Storyboard.TargetProperty="ScaleX" To="0.98" Duration="{StaticResource MotionHover}" /><DoubleAnimation Storyboard.TargetName="Motion" Storyboard.TargetProperty="ScaleY" To="0.98" Duration="{StaticResource MotionHover}" /></Storyboard></BeginStoryboard></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Motion" Storyboard.TargetProperty="ScaleX" To="1.02" Duration="{StaticResource MotionHover}" /><DoubleAnimation Storyboard.TargetName="Motion" Storyboard.TargetProperty="ScaleY" To="1.02" Duration="{StaticResource MotionHover}" /></Storyboard></BeginStoryboard></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface2Brush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource MutedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Cartão que se escolhe (modo do benchmark, disco): fica de vidro com borda amarela quando marcado -->
    <Style x:Key="SelectCard" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="{StaticResource SurfaceBrush}" CornerRadius="14"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="14,12" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform><ScaleTransform x:Name="Motion" /></Border.RenderTransform>
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Motion" Storyboard.TargetProperty="ScaleX" To="1.02" Duration="{StaticResource MotionHover}" /><DoubleAnimation Storyboard.TargetName="Motion" Storyboard.TargetProperty="ScaleY" To="1.02" Duration="{StaticResource MotionHover}" /></Storyboard></BeginStoryboard></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Motion" Storyboard.TargetProperty="ScaleX" To="1" Duration="{StaticResource MotionHover}" /><DoubleAnimation Storyboard.TargetName="Motion" Storyboard.TargetProperty="ScaleY" To="1" Duration="{StaticResource MotionHover}" /></Storyboard></BeginStoryboard></Trigger.ExitActions>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface2Brush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#66FFC400" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource GlassSelectedBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentGradientBrush}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="1.5" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#FFC400" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Chip que liga e desliga (o que testar, resolução) -->
    <Style x:Key="ChipToggle" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="#B4B4BC" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="{StaticResource SurfaceBrush}" CornerRadius="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12,6">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#66FFC400" />
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource GlassSelectedBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentGradientBrush}" />
                            <Setter Property="Foreground" Value="#FFC400" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#FFC400" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Aba de página (Novo teste, Em andamento...): sublinhado em degradê na escolhida -->
    <Style x:Key="PageTab" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="10,10,0,0" Padding="14,8,14,10">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="Line" Height="2.5" CornerRadius="1.5" VerticalAlignment="Bottom" Margin="10,0" Background="{StaticResource AccentGradientBrush}" Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#0DFFFFFF" />
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Line" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource MotionHover}" /></Storyboard></BeginStoryboard></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Line" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource MotionHover}" /></Storyboard></BeginStoryboard></Trigger.ExitActions>
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource GlassSelectedBrush}" />
                            <Setter Property="Foreground" Value="#FFC400" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#FFC400" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Caixa de seleção arredondada -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Box" Width="20" Height="20" CornerRadius="6" VerticalAlignment="Top"
                                Background="Transparent" BorderBrush="{StaticResource MutedBrush}" BorderThickness="1.5">
                            <Path x:Name="Mark" Data="M 4,10 L 8,14 L 15,5" Stroke="#0B0B0B" StrokeThickness="2.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Visibility="Collapsed" Margin="0,0,0,0" />
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="2,0,0,0" VerticalAlignment="Top" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Campo de texto escuro e arredondado -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Campo de senha escuro (chave de transmissão) -->
    <Style TargetType="PasswordBox">
        <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Barra de rolagem fina e escura -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#3A3A42" CornerRadius="5" Margin="2,0" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- Foco do teclado visível em todos os controles (Tab): contorno amarelo tracejado -->
    <Style x:Key="{x:Static SystemParameters.FocusVisualStyleKey}">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" RadiusX="6" RadiusY="6" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" StrokeDashArray="2 1" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

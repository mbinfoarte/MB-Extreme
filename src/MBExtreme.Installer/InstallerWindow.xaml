<Window x:Class="MBExtreme.Installer.InstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Instalar MB Extreme (Beta 01)" Width="640" Height="500" ResizeMode="NoResize"
        WindowStyle="None" WindowStartupLocation="CenterScreen"
        Icon="Assets/app.ico"
        Background="#050505" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <!-- Barra neon amarela: trilho preto fino e preenchimento com brilho -->
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="8" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" CornerRadius="4" Background="#141414" BorderBrush="#3A2F00" BorderThickness="1" />
                            <Border x:Name="PART_Indicator" CornerRadius="4" HorizontalAlignment="Left">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#FFB800" Offset="0" />
                                        <GradientStop Color="#FFE23D" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect Color="#FFD400" BlurRadius="18" ShadowDepth="0" Opacity="0.95" />
                                </Border.Effect>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Content" Value="✕" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2A2A" />
                                <Setter Property="Foreground" Value="#FFD400" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Dot" TargetType="Border">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Margin" Value="5,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#3A3A3A" />
        </Style>
    </Window.Resources>

    <Border BorderBrush="#4A3C00" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Barra de título própria (arrastar a janela; fechar) -->
            <Grid Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
                <TextBlock Text="Instalar MB Extreme (Beta 01)" FontSize="11" Foreground="#6A6A6A" Margin="14,9,0,0" HorizontalAlignment="Left" />
                <Button x:Name="CloseButton" Style="{StaticResource CloseButton}" HorizontalAlignment="Right" Click="CancelButton_Click" />
            </Grid>

            <!-- Conteúdo centralizado -->
            <Grid Grid.Row="1" Margin="48,0,48,0">
                <StackPanel VerticalAlignment="Center">
                    <!-- Marca -->
                    <Border Width="76" Height="76" CornerRadius="18" ClipToBounds="True" HorizontalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect Color="#FFD400" BlurRadius="26" ShadowDepth="0" Opacity="0.45" />
                        </Border.Effect>
                        <Image Source="Assets/logo.png" Stretch="UniformToFill" />
                    </Border>
                    <TextBlock FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,14,0,0">
                        <Run Text="MB " /><Run Text="EXTREME" Foreground="{StaticResource AccentBrush}" />
                    </TextBlock>
                    <TextBlock Text="Instalador · Beta · MB InfoArt" FontSize="12" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />

                    <!-- Página 1: opções -->
                    <StackPanel x:Name="WelcomePage" Margin="0,26,0,0">
                        <TextBlock Text="Pasta de instalação" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="DirectoryBox" IsReadOnly="True" />
                            <Button Grid.Column="1" Content="Alterar..." Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                                    Click="ChangeDirectory_Click" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <CheckBox x:Name="StartMenuBox" Content="Atalho no menu Iniciar" IsChecked="True" Foreground="{StaticResource TextBrush}" />
                            <CheckBox x:Name="DesktopBox" Content="Atalho na área de trabalho" IsChecked="True" Margin="24,0,0,0" Foreground="{StaticResource TextBrush}" />
                        </StackPanel>
                        <TextBlock Margin="0,16,0,0" TextWrapping="Wrap" FontSize="11" Foreground="#7A7A7A"
                                   Text="Pede permissão de administrador. Nada é alterado no Windows até você aplicar ajustes dentro do programa." />
                    </StackPanel>

                    <!-- Página 2: instalação com tutorial curto -->
                    <StackPanel x:Name="InstallPage" Visibility="Collapsed" Margin="0,26,0,0">
                        <Border Background="#0E0E0E" BorderBrush="#2B2300" BorderThickness="1" CornerRadius="14" Padding="22,18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="52" Height="52" CornerRadius="26" Background="#1A1500" BorderBrush="#FFD400" BorderThickness="1.5" VerticalAlignment="Center">
                                    <TextBlock x:Name="SlideGlyph" FontSize="24" FontFamily="Segoe UI Symbol" Foreground="{StaticResource AccentBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="SlideTitle" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock x:Name="SlideText" Margin="0,3,0,0" FontSize="12.5" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                            <Button Content="‹" Style="{StaticResource GhostButton}" Padding="12,0" Click="PreviousSlide_Click" />
                            <StackPanel x:Name="DotsPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0" />
                            <Button Content="›" Style="{StaticResource GhostButton}" Padding="12,0" Click="NextSlide_Click" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Rodapé: botões e (na instalação) status e porcentagem -->
            <Grid Grid.Row="2" Margin="30,0,30,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="StatusPanel" Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                    <CheckBox x:Name="LaunchBox" Content="Abrir o MB Extreme (Beta 01) ao concluir" IsChecked="True" Margin="0,6,0,0"
                              Visibility="Collapsed" Foreground="{StaticResource TextBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="PercentText" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Text="0%"
                               VerticalAlignment="Center" Margin="0,0,16,0" Visibility="Collapsed" />
                    <Button x:Name="CancelButton" Content="Cancelar" Style="{StaticResource GhostButton}" Click="CancelButton_Click" />
                    <Button x:Name="PrimaryButton" Content="Instalar" Style="{StaticResource PrimaryButton}" Margin="12,0,0,0"
                            Click="PrimaryButton_Click" />
                </StackPanel>
            </Grid>

            <!-- Linha de progresso neon na base da janela -->
            <ProgressBar x:Name="Bar" Grid.Row="3" Margin="0,0,0,0" Value="0" Height="8" Visibility="Hidden" />
        </Grid>
    </Border>
</Window>

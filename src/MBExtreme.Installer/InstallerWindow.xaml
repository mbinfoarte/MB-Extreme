<Window x:Class="MBExtreme.Installer.InstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Instalar MB Extreme" Width="780" Height="600" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/app.ico"
        Background="{StaticResource WindowBackdropBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="14" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" CornerRadius="7" Background="{StaticResource Surface2Brush}" />
                            <Border x:Name="PART_Indicator" CornerRadius="7" HorizontalAlignment="Left"
                                    Background="{StaticResource AccentBrush}">
                                <Border.Effect>
                                    <DropShadowEffect Color="#FFCC00" BlurRadius="12" ShadowDepth="0" Opacity="0.5" />
                                </Border.Effect>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MockPill" TargetType="Border">
            <Setter Property="Height" Value="20" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Margin" Value="0,0,0,5" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
        </Style>
        <Style x:Key="MockCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Background" Value="{StaticResource Surface2Brush}" />
        </Style>
    </Window.Resources>

    <Grid Margin="28,22,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <StackPanel Orientation="Horizontal">
            <Border Width="52" Height="52" CornerRadius="12" ClipToBounds="True">
                <Image Source="Assets/logo.png" Stretch="UniformToFill" />
            </Border>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock FontSize="26" FontWeight="Bold">
                    <Run Text="MB " /><Run Text="EXTREME" Foreground="{StaticResource AccentBrush}" />
                </TextBlock>
                <TextBlock Text="Instalador · MB InfoArt" FontSize="12" Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
        </StackPanel>

        <!-- Conteúdo -->
        <Grid Grid.Row="1" Margin="0,18,0,12">

            <!-- Página 1: boas-vindas e opções -->
            <StackPanel x:Name="WelcomePage" VerticalAlignment="Center">
                <TextBlock Text="Bem-vindo!" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Margin="0,8,0,22" TextWrapping="Wrap" FontSize="14" Foreground="{StaticResource MutedBrush}"
                           Text="O MB Extreme vai ser instalado neste computador. Durante a instalação você vê um tutorial rápido de como o programa funciona." />

                <TextBlock Text="Pasta de instalação" Foreground="{StaticResource MutedBrush}" />
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="DirectoryBox" IsReadOnly="True" />
                    <Button Grid.Column="1" Content="Alterar..." Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                            Click="ChangeDirectory_Click" />
                </Grid>

                <CheckBox x:Name="StartMenuBox" Content="Criar atalho no menu Iniciar" IsChecked="True" Margin="0,22,0,0"
                          Foreground="{StaticResource TextBrush}" />
                <CheckBox x:Name="DesktopBox" Content="Criar atalho na área de trabalho" IsChecked="True" Margin="0,8,0,0"
                          Foreground="{StaticResource TextBrush}" />

                <TextBlock Margin="0,26,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedBrush}"
                           Text="O instalador e o programa pedem permissão de administrador, porque alteram configurações do Windows. Nada é alterado até você aplicar os ajustes dentro do programa." />
            </StackPanel>

            <!-- Página 2: instalação com mini tutorial -->
            <Grid x:Name="InstallPage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Miniatura do sistema -->
                    <Border Width="460" Height="230" Style="{StaticResource Card}" Padding="0" ClipToBounds="True"
                            HorizontalAlignment="Center">
                        <Grid>
                            <!-- Slide 1: menu -->
                            <Grid x:Name="Slide1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="#66000000" Padding="12">
                                    <StackPanel>
                                        <TextBlock FontSize="11" FontWeight="Bold" Margin="0,0,0,10">
                                            <Run Text="MB " /><Run Text="EXTREME" Foreground="{StaticResource AccentBrush}" />
                                        </TextBlock>
                                        <Border Style="{StaticResource MockPill}" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource MutedBrush}" BorderThickness="1">
                                            <TextBlock Text="Início" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </Border>
                                        <Border Style="{StaticResource MockPill}"><TextBlock Text="Desempenho" FontSize="10" VerticalAlignment="Center" /></Border>
                                        <Border Style="{StaticResource MockPill}"><TextBlock Text="Jogos e GPU" FontSize="10" VerticalAlignment="Center" /></Border>
                                        <Border Style="{StaticResource MockPill}"><TextBlock Text="Memória" FontSize="10" VerticalAlignment="Center" /></Border>
                                        <Border Style="{StaticResource MockPill}"><TextBlock Text="DNS" FontSize="10" VerticalAlignment="Center" /></Border>
                                        <Border Style="{StaticResource MockPill}"><TextBlock Text="Aplicativos" FontSize="10" VerticalAlignment="Center" /></Border>
                                    </StackPanel>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="18,16,18,0">
                                    <TextBlock Text="Início" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                                    <Border Style="{StaticResource MockCard}"><TextBlock Text="Saúde do PC: boa" FontSize="11" Foreground="{StaticResource OkBrush}" /></Border>
                                    <Border Style="{StaticResource MockCard}"><TextBlock Text="Memória: 22% livre · precisa de limpeza" FontSize="11" Foreground="{StaticResource WarnBrush}" /></Border>
                                    <Border Style="{StaticResource MockCard}"><TextBlock Text="DNS mais rápido: 37 ms" FontSize="11" /></Border>
                                </StackPanel>
                            </Grid>

                            <!-- Slide 2: ajustes -->
                            <Grid x:Name="Slide2" Visibility="Collapsed">
                                <StackPanel Margin="22,16,22,0">
                                    <TextBlock Text="Jogos e GPU" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                                    <Border Style="{StaticResource MockCard}">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="14" Height="14" CornerRadius="3" Background="{StaticResource AccentBrush}" Margin="0,0,10,0" />
                                                <TextBlock Text="Desativar gravação em segundo plano" FontSize="11" />
                                            </StackPanel>
                                            <TextBlock Text="risco baixo" FontSize="10" HorizontalAlignment="Right" Foreground="{StaticResource OkBrush}" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource MockCard}">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="14" Height="14" CornerRadius="3" Background="{StaticResource AccentBrush}" Margin="0,0,10,0" />
                                                <TextBlock Text="Prioridade para jogos" FontSize="11" />
                                            </StackPanel>
                                            <TextBlock Text="risco baixo" FontSize="10" HorizontalAlignment="Right" Foreground="{StaticResource OkBrush}" />
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource MockCard}">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="14" Height="14" CornerRadius="3" BorderBrush="{StaticResource MutedBrush}" BorderThickness="1" Margin="0,0,10,0" />
                                                <TextBlock Text="Desativar HAGS" FontSize="11" />
                                            </StackPanel>
                                            <TextBlock Text="risco médio" FontSize="10" HorizontalAlignment="Right" Foreground="{StaticResource WarnBrush}" />
                                        </Grid>
                                    </Border>
                                    <Border Background="{StaticResource ButtonBrush}" CornerRadius="6" Padding="14,6" HorizontalAlignment="Left" Margin="0,6,0,0">
                                        <TextBlock Text="Aplicar alterações" FontSize="11" FontWeight="SemiBold" Foreground="#0B0B0B" />
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- Slide 3: progresso -->
                            <Grid x:Name="Slide3" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="18,24,0,0">
                                    <TextBlock Text="Limpeza de memória" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,12" TextWrapping="Wrap" />
                                    <TextBlock Text="✓  Processos" FontSize="11" Margin="0,0,0,6" />
                                    <TextBlock Text="▶  Cache" FontSize="11" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <TextBlock Text="•  Concluir" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                </StackPanel>
                                <Grid Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="130" Height="130">
                                    <Ellipse Width="96" Height="96" Stroke="{StaticResource Surface2Brush}" StrokeThickness="9" />
                                    <Path Data="M 65,17 A 48,48 0 1 1 17.85,74" Stroke="{StaticResource AccentBrush}" StrokeThickness="9"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    <TextBlock Text="72%" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </Grid>

                            <!-- Slide 4: desfazer -->
                            <Grid x:Name="Slide4" Visibility="Collapsed">
                                <StackPanel Margin="22,18,22,0">
                                    <TextBlock Text="Central de ações" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                                    <Border Style="{StaticResource MockCard}"><TextBlock Text="✓  Ponto de restauração criado antes de remover aplicativos" FontSize="11" Foreground="{StaticResource OkBrush}" /></Border>
                                    <Border Style="{StaticResource MockCard}"><TextBlock Text="Valor original guardado para cada ajuste aplicado" FontSize="11" /></Border>
                                    <Border BorderBrush="{StaticResource MutedBrush}" BorderThickness="1" CornerRadius="6" Padding="14,6" HorizontalAlignment="Left" Margin="0,6,0,0">
                                        <TextBlock Text="Restaurar originais" FontSize="11" FontWeight="SemiBold" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Legenda -->
                    <TextBlock x:Name="SlideTitle" Margin="0,16,0,0" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock x:Name="SlideText" Margin="0,4,0,0" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="520"
                               Foreground="{StaticResource MutedBrush}" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                        <Button Content="‹" Style="{StaticResource GhostButton}" Padding="12,2" Click="PreviousSlide_Click" />
                        <TextBlock x:Name="SlideDots" Margin="14,0" VerticalAlignment="Center" FontSize="14" />
                        <Button Content="›" Style="{StaticResource GhostButton}" Padding="12,2" Click="NextSlide_Click" />
                    </StackPanel>
                </StackPanel>

                <!-- Barra de progresso -->
                <StackPanel Grid.Row="1" Margin="0,10,0,0">
                    <Grid>
                        <TextBlock x:Name="StatusText" FontSize="13" />
                        <TextBlock x:Name="PercentText" FontSize="13" HorizontalAlignment="Right" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}" Text="0%" />
                    </Grid>
                    <ProgressBar x:Name="Bar" Margin="0,6,0,0" Value="0" />
                    <CheckBox x:Name="LaunchBox" Content="Abrir o MB Extreme ao concluir" IsChecked="True" Margin="0,12,0,0"
                              Visibility="Collapsed" Foreground="{StaticResource TextBrush}" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Rodapé -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="Cancelar" Style="{StaticResource GhostButton}" Click="CancelButton_Click" />
            <Button x:Name="PrimaryButton" Content="Instalar" Style="{StaticResource PrimaryButton}" Margin="12,0,0,0"
                    Click="PrimaryButton_Click" />
        </StackPanel>
    </Grid>
</Window>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>MBExtreme.Installer</RootNamespace>
    <AssemblyName>MBExtreme-Setup</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\MBExtreme.App\Assets\app.ico</ApplicationIcon>
    <Version>0.2.0</Version>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compartilha o tema e o logotipo com o aplicativo. -->
    <Page Include="..\MBExtreme.App\Themes\Theme.xaml" Link="Themes\Theme.xaml" />
    <Resource Include="..\MBExtreme.App\Assets\logo.png" Link="Assets\logo.png" />
    <Resource Include="..\MBExtreme.App\Assets\app.ico" Link="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- O pacote do aplicativo (zip) é embutido no instalador. Passe -p:PayloadZip=caminho\payload.zip. -->
    <EmbeddedResource Include="$(PayloadZip)" LogicalName="payload.zip" Condition="'$(PayloadZip)' != '' And Exists('$(PayloadZip)')" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MBExtreme.Core\MBExtreme.Core.csproj" />
  </ItemGroup>

</Project>

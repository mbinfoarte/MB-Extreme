<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MBExtreme.LicenseServer</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Banco de dados SQLite (domínio público). -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
  </ItemGroup>

  <ItemGroup>
    <!-- Textos legais (Markdown) copiados da documentação. O logo e as imagens do site ficam em wwwroot/. -->
    <Content Include="..\..\docs\TERMOS-DE-USO.md" Link="legal\termos.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\docs\POLITICA-PRIVACIDADE.md" Link="legal\privacidade.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MBExtreme.Core\MBExtreme.Core.csproj" />
  </ItemGroup>

</Project>
